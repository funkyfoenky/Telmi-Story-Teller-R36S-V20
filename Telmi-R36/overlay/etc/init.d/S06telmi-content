#!/bin/sh
# Monte contenu Telmi (dual-SD : slot gauche prioritaire, fallback p3 OS) + bind .tmp_update

TELMI_MOUNT=/opt/telmi/bin/telmi-mount-content.sh

case "$1" in
	start)
		if [ -x "$TELMI_MOUNT" ]; then
			"$TELMI_MOUNT" setup || true
		else
			echo "WARN: $TELMI_MOUNT absent" >&2
		fi
		;;
	stop)
		umount /telmi/.tmp_update 2>/dev/null || true
		umount /telmi 2>/dev/null || true
		rm -f /run/telmi-content-mode
		;;
	*) exit 1 ;;
esac

exit 0
